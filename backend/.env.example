# Скопируйте в .env и заполните. Файл .env не коммитим!
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://labflow:labflow@localhost:5432/labflow
# В production обязательно длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Для разработки можно не задавать (есть встроенный dev-ключ). В production — обязательно:
# SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=["http://localhost:5173"]
QUEUE_TICK_SECONDS=60
